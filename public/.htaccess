# ============================
# SECURITY HEADERS
# ============================

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.joechamdani.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://joechamdani.com https://analytics.joechamdani.com; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ============================
# URL REWRITING
# ============================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Custom 404 page. Served with a REAL 404 status, unlike /index.html which
    # would return 200 and hand crawlers the whole homepage at a bogus URL.
    ErrorDocument 404 /404.html

    # Remove .html extension for project reports
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ $1.html [L,QSA]

    # 301 redirect from .html URLs to clean URLs (except index.html)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
    RewriteCond %{REQUEST_URI} !^/index\.html$ [NC]
    RewriteRule ^ %1 [R=301,L]

    # A directory with no index file is not a page. Force a real 404 rather than
    # serving the SPA shell with a 200 (a soft 404).
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteRule ^ - [L,R=404]

    # NO catch-all SPA fallback on purpose.
    #
    # Every route in src/App.tsx has a real file on disk: "/" is index.html and
    # "/projects/INFO_300" is a directory with its own index.html. So anything that
    # reaches this point genuinely does not exist and must return 404, not 200.
    #
    # If you ever add a React-only route with NO file behind it, add it here or it
    # will 404 correctly but unhelpfully:
    #
    #   RewriteCond %{REQUEST_URI} ^/your-new-route/?$
    #   RewriteRule ^ index.html [L]
</IfModule>
